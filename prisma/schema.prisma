generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Article {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  category  String
  ageTag    String
  readTime  String
  excerpt   String
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

// Bình luận — gắn với email người dùng đăng nhập qua Supabase Auth
// (không cần bảng User riêng, Supabase đã quản lý tài khoản)
model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  authorEmail String
  authorName  String?
  createdAt   DateTime @default(now())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
}

// Sản phẩm gợi ý (affiliate) — hiển thị trên trang chủ và cuối mỗi bài viết
model Product {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  price       String?
  affiliateUrl String
  note        String? // ví dụ: "Được nhiều mẹ tin dùng"
  category    String // khớp với category của Article để gợi ý đúng chủ đề
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// Hồ sơ bé của mỗi phụ huynh (gắn theo email đăng nhập)
model Baby {
  id           String         @id @default(cuid())
  ownerEmail   String
  name         String
  birthDate    DateTime
  gender       String // "male" | "female"
  createdAt    DateTime       @default(now())
  growthRecords GrowthRecord[]

  @@index([ownerEmail])
}

// Mỗi lần đo cân nặng / chiều cao của bé
model GrowthRecord {
  id          String   @id @default(cuid())
  date        DateTime
  weightKg    Float?
  heightCm    Float?
  headCm      Float?
  createdAt   DateTime @default(now())

  baby   Baby   @relation(fields: [babyId], references: [id], onDelete: Cascade)
  babyId String

  @@index([babyId])
}
